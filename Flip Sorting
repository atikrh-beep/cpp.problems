#include<iostream>
using namespace std;
int main(){
 int N,temp;
 while(cin>>N){
    int M=0;
 int ann[N];
 for(int i = 0; i<N; i++){
     cin >> ann[i];
 }
 for(int i = 0; i<N; i++){
 for (int j=0; j<N-1; j++){
     if(ann[j]>ann[j+1]){
         temp = ann[j];
         ann[j] = ann[j+1];
         ann[j+1] = temp;
         M++;
     }
 }
}
    cout <<"Minimum exchange operations : "<<M<<endl;
 }
    return 0;
}
