#include <stdio.h>
#include<stdlib.h>
int compare(void const *a,void const *b){
    int x = *(const int*)a;
        int y = *(const int*)b;
     if(x<y) return -1;
     if(x>y) return 1;
     return 0;
}
int main(){
   int n;
   scanf("%d",&n);
   while(n--){
       int k;
       scanf("%d",&k);
       int arr[k];
       for(int j=0; j<k; j++){
           scanf("%d",&arr[j]);
       }
    qsort(arr, k, sizeof(int), compare);   
       int dd = arr[k-1]-arr[0];
      printf("%d\n",dd*2);
   }
       return 0;
   }
