#include <iostream>
using namespace std;
int main(){
    int n;
    while (cin>>n){
        if (n==0)
            break;

        int age[100] = {0};
        for (int i = 0; i < n; i++){
            int x;
            cin >> x;
            age[x]++;
        }
        bool first = true;
        for (int i = 1; i <= 99; i++){
            while (age[i] > 0){
                if (!first)
                    cout << " ";
                cout << i;
                first = false;
                age[i]--;
            }
        }
        cout << endl;
    }
    return 0;
}
